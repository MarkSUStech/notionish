{
  "name": "notionish",
  "version": "1.0.0",
  "description": "Notionish — 本地优先的 Notion 风格笔记应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.notionish.app",
    "productName": "Notionish",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "../server.js",
      "../server-ai.js",
      "../server-kb.js",
      "../server-mcp.js",
      "../server-memory.js",
      "../index.html",
      "../css/**/*",
      "../js/**/*",
      "../vendor/**/*",
      "../skills/**/*",
      "../clip.html"
    ],
    "win": {
      "target": ["nsis"],
      "icon": null,
      "sign": null
    },
    "mac": {
      "target": ["dmg"],
      "icon": null
    },
    "linux": {
      "target": ["AppImage"],
      "icon": null
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}