{
  "name": "notionish",
  "version": "1.0.1",
  "description": "Notionish — 本地优先的 Notion 风格笔记应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.notionish.app",
    "productName": "Notionish",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      { "from": "../server.js", "to": "server.js" },
      { "from": "../server-ai.js", "to": "server-ai.js" },
      { "from": "../server-kb.js", "to": "server-kb.js" },
      { "from": "../server-mcp.js", "to": "server-mcp.js" },
      { "from": "../server-memory.js", "to": "server-memory.js" },
      { "from": "../demo/index.html", "to": "index.html" },
      { "from": "../clip.html", "to": "clip.html" },
      { "from": "../demo/css", "to": "css" },
      { "from": "../demo/js", "to": "js" },
      { "from": "../demo/vendor", "to": "vendor" },
      { "from": "../skills", "to": "skills" }
    ],
    "win": {
      "target": ["dir"],
      "icon": null,
      "sign": null,
      "signAndEditExecutable": false
    },
    "mac": {
      "target": ["dmg"],
      "icon": null
    },
    "linux": {
      "target": ["AppImage"],
      "icon": null
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}